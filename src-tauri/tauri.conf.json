{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Videe",
  "version": "0.1.0",
  "identifier": "com.aqil.videe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Videe",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "resources": {
      "../integrations/resolve/Videe.lua": "Videe.lua",
      "binaries/ffmpeg-COPYING.LGPLv2.1": "licenses/ffmpeg/COPYING.LGPLv2.1",
      "binaries/ffmpeg-build.txt": "licenses/ffmpeg/BUILD.txt"
    }
  }
}
